<td style="text-align: right;">1</td>
</tr>
<tr>
<td>beta</td>
<td style="text-align: right;">22</td>
</tr>
</tbody></table>
<section id="A-third-level-heading">
<h3>A third-level heading</h3>
<p>Text.</p>
</section>
</section>
</section>
