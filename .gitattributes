# `git archive` omits these files, which are not part of the extension, from
# the package for the Chrome Web Store.  See
# docs/publishing-chrome-web-store.md.
.gitattributes export-ignore
.gitignore export-ignore
README.md export-ignore
docs export-ignore
package.json export-ignore
package-lock.json export-ignore
test export-ignore
vendor/update.sh export-ignore
